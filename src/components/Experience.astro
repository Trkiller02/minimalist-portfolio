---
import LayoutComponents from "./ui/LayoutComponents.astro";

interface Props {
	experience: Array<{
		name: string;
		time: string;
		profession: string;
		items: string[];
	}>;
	english?: boolean;
}

const { experience, english } = Astro.props;
---

<LayoutComponents>
  <h2
    class="text-3xl font-semibold mb-4 max-sm:text-xl max-sm:mb-2 print:text-xl print:mb-2 print:uppercase"
    id="experience"
  >
    {english ? "Work Experience" : "Experiencia laboral"}
  </h2>
  {
    experience.map((info) => (
      <div class="my-2 w-full pb-1">
        <div class="w-full flex justify-between">
          <h3 class="text-xl font-semibold max-sm:text-sm max-sm:p-0 print:text-black ">
          {info.profession}
        </h3>
          
          <span class="flex text-xl text-gray-700 pb-1 ml-6 max-sm:text-xs max-sm:ml-2 w-1/4 justify-end whitespace-nowrap print:text-black print:whitespace-normal">
            {info.time}
          </span>
        </div>
        <p class="text-base text-gray-700 pb-1 max-sm:text-sm max-sm:p-0 print:font-normal">
            {info.name}
        </p>
        <ul class="text-base print:text-sm mt-2 ml-10 text-gray-900">
          {info.items.map(item => (
            <ol class="my-1 print:my-1.5 list-disc list-item">
              {item}
            </ol>
          ))}
        </ul>
      </div>
    ))
  }
</LayoutComponents>
