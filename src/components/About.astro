---
import LayoutComponents from "./ui/LayoutComponents.astro";

interface Props {
	about: string;
	english?: boolean;
}

const { about, english } = Astro.props;
---

<LayoutComponents>
  <h2 class="text-3xl font-semibold mb-4 max-sm:text-xl max-sm:mb-2 print:text-xl print:mb-2 print:uppercase" id="about">
    {english ? "Profile" : "Perfil"}
  </h2>
  <p
    class="text-lg text-gray-500 pb-1 max-sm:text-sm max-sm:p-0 print:text-black print:text-base"
  >
    {about}
  </p>
</LayoutComponents>