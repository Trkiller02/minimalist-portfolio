---
import Education from "@/components/Education.astro";
import Profile from "@/components/Profile.astro";
import Skills from "@/components/Skills.astro";
import Layout from "@/layouts/Layout.astro";
import About from "@/components/About.astro";
import Courses from "@/components/Courses.astro";

import {
  profile,
  education,
  courses,
} from "@/db/data-es.json" with { type: "json" };

import { contact, address } from "@/db/contact-info.json" with { type: "json" };

import { skills } from "@/db/skills.json" with { type: "json" };
---

<Layout title="Omar Márquez | CV">
  <Profile info={{ contact, address, ...profile }} />
  <About about={profile.about} />
  <Skills skills={skills} />
  <Education education={education} />
  <Courses courses={courses} />
</Layout>
