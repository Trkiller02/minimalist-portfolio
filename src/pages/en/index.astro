---
import Profile from "@/components/Profile.astro";
import Layout from "@/layouts/Layout.astro";
import About from "@/components/About.astro";
import Skills from "@/components/Skills.astro";
import Education from "@/components/Education.astro";
import Courses from "@/components/Courses.astro";
import Experience from "@/components/Experience.astro";

import {
	profile,
	education,
	courses,
	experience,
} from "@/db/data-en.json" with { type: "json" };

import { contact, address } from "@/db/contact-info.json" with { type: "json" };

import { skills } from "@/db/skills.json" with { type: "json" };
---

<Layout title="Omar Márquez | CV" lang="en">
    <Profile info={{ contact, address, ...profile }} english />
    <About about={profile.about} english />
    <Experience experience={experience} english />
    <Education education={education} english />
    <Skills skills={skills} english />
    <Courses courses={courses} english />
</Layout>
